{
  "manifest_version": 3,
  "name": "iOffice Beauti",
  "version": "1.0",
  "description": "Bổ sung chức năng cho iOffice Đắk Lắk",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "iOffice Beauti",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vpdt.daklak.gov.vn/*"
      ],
      "js": [
        "features/hide-loading/script.js",
        "content.js"
      ],
      "css": [
        "styles/style.css"
      ],
      "run_at": "document_idle"
    }
  ]
}