{
  "manifest_version": 3,
  "name": "iOffice Beauti",
  "version": "1.0",
  "description": "Bổ sung chức năng cho iOffice Đắk Lắk",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "iOffice Beauti",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ioffice.vnptdaklak.vn/*",
        "https://vpdt.daklak.gov.vn/*"
      ],
      "js": [
        "features/hide-loading/script.js",
        "content.js",
        "inject.js"
      ],
      "css": [
        "styles/style.css"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}